# Backend (local .env, or Render -> Environment)
GOOGLE_API_KEY=your_google_api_key_here
QDRANT_URL=your_qdrant_url_here
QDRANT_API_KEY=your_qdrant_api_key_here
# Shared secret the frontend must send; set the same value in Streamlit secrets
API_KEY=generate_a_long_random_string
# Optional overrides (defaults shown)
LLM_MODEL=gemini-3.5-flash-lite
LLM_THINKING_LEVEL=low
COLLECTION_NAME=enterprise_rag_docs
RATE_LIMIT=30/minute
MAX_UPLOAD_MB=20

# Frontend (Streamlit secrets, or environment variables when running locally)
# BACKEND_URL=https://your-backend.onrender.com
# API_KEY=same_value_as_backend
